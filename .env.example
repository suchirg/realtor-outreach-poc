# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/realestate_photo_poc

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# Scraping Configuration
TARGET_ZIP_CODE=60610
ZILLOW_HEADERS_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
SCRAPER_HEADLESS=True
SCRAPER_TIMEOUT=30
MIN_PHOTOS_THRESHOLD=5
SCRAPER_DELAY_SECONDS=2

# Listing Quality Thresholds
MIN_LISTING_DAYS_ACTIVE=7
MAX_LISTING_DAYS_ACTIVE=180
MIN_PRICE=50000
MAX_PRICE=5000000

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
MESSAGE_GENERATION_TEMPERATURE=0.7

# Email Configuration
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@yourphotographyservice.com
SENDGRID_FROM_NAME=Real Estate Photography

# Alternative Email (Mailgun)
MAILGUN_API_KEY=key-your-mailgun-api-key-here
MAILGUN_DOMAIN=mg.yourphotographyservice.com
MAILGUN_FROM_EMAIL=noreply@yourphotographyservice.com

# Photography Pricing
DEFAULT_SESSION_PRICE=299
PRICE_PER_SQFT=0.15
LUXURY_PROPERTY_MULTIPLIER=1.5

# Dashboard & UI
DASHBOARD_PORT=5000
DASHBOARD_HOST=0.0.0.0
MAX_LISTINGS_PER_PAGE=20
SESSION_TIMEOUT_MINUTES=60

# Redis Configuration (for Celery task queue)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# MLS & Contact Data Sources
MLS_API_KEY=your-mls-api-key-here
MLS_API_ENDPOINT=https://api.mls.com/v1
ZILLOW_API_KEY=your-zillow-api-key-here

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/app.log

# Sentry (Error Tracking - Optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Feature Flags
ENABLE_SELENIUM_SCRAPING=True
ENABLE_ZILLOW_API=False
ENABLE_EMAIL_SENDING=False
ENABLE_ANALYTICS=True
DRY_RUN_MODE=True

# Outreach Configuration
OUTREACH_MAX_RETRIES=3
OUTREACH_RETRY_DELAY_HOURS=24
RESPONSE_TRACKING_ENABLED=True
INCLUDE_CALENDAR_LINK=True
CALENDAR_LINK_TYPE=calendly

# Contact Form Configuration
CONTACT_FORM_EMAIL=bookings@yourphotographyservice.com
CONTACT_FORM_PHONE=+1-555-0123

# Deployment
APP_ENV=development
HEROKU_APP_NAME=realestate-photo-poc
DEBUG_MODE=True

# Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
CSRF_ENABLED=True
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=3600